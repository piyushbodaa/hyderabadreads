{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "regions": ["sin1"],
  "functions": {
    "api/page.js": {
      "includeFiles": "server/generated/*.html"
    },
    "api/og.js": {
      "includeFiles": "{public/covers/**,public/logo-512.png,node_modules/@fontsource/fraunces/files/fraunces-latin-500-normal.woff,node_modules/@fontsource/inter/files/inter-latin-400-normal.woff,node_modules/@fontsource/inter/files/inter-latin-600-normal.woff}"
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval' https://*.googletagmanager.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://*.google-analytics.com https://*.googletagmanager.com; font-src 'self'; connect-src 'self' https://*.google-analytics.com https://*.analytics.google.com https://*.googletagmanager.com; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests"
        },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(self), microphone=(), geolocation=(), payment=(), usb=()" },
        { "key": "Cross-Origin-Opener-Policy", "value": "same-origin" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/covers/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=604800, stale-while-revalidate=86400" }]
    }
  ],
  "rewrites": [
    { "source": "/", "destination": "/api/page?route=home" },
    { "source": "/book/:slug", "destination": "/api/page?route=book&slug=:slug" },
    { "source": "/shelf/:slug", "destination": "/api/page?route=shelf&slug=:slug" },
    { "source": "/og/:kind/:file", "destination": "/api/og?kind=:kind&file=:file" },
    { "source": "/llms.txt", "destination": "/api/feeds?feed=llms" },
    { "source": "/llms-full.txt", "destination": "/api/feeds?feed=llms-full" },
    { "source": "/library.json", "destination": "/api/feeds?feed=json" },
    { "source": "/sitemap.xml", "destination": "/api/feeds?feed=sitemap" },
    { "source": "/meetups.ics", "destination": "/api/feeds?feed=ics" },
    { "source": "/join/:token", "destination": "/api/app?route=join&token=:token" },
    { "source": "/media/:file", "destination": "/api/app?route=media&file=:file" },
    { "source": "/me", "destination": "/me.html" },
    { "source": "/admin", "destination": "/admin.html" },
    { "source": "/bookplates", "destination": "/bookplates.html" },
    { "source": "/digest", "destination": "/digest.html" },
    { "source": "/api/:route", "destination": "/api/app?route=:route" }
  ],
  "redirects": [
    { "source": "/", "has": [{ "type": "host", "value": "www.hyderabadreads.fun" }], "destination": "https://hyderabadreads.fun/", "permanent": true },
    { "source": "/:path*", "has": [{ "type": "host", "value": "www.hyderabadreads.fun" }], "destination": "https://hyderabadreads.fun/:path*", "permanent": true }
  ]
}
